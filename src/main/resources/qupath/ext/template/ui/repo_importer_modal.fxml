<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<?import javafx.geometry.Insets?>
<fx:root type="VBox" prefWidth="640" prefHeight="480" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" xmlns="http://javafx.com/javafx/20" xmlns:fx="http://javafx.com/fxml/1">
    <VBox spacing="5" alignment="CENTER_RIGHT" VBox.vgrow="ALWAYS">
	<padding>
            <Insets topRightBottomLeft="3"/>
        </padding>
	<TextField fx:id="searchField" promptText="Search by name..."/>
	<StackPane VBox.vgrow="ALWAYS">
	    <TableView fx:id="tableView">
		<columns>
		    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
		    <TableColumn fx:id="nameColumn" text="Name" prefWidth="150"/>
		    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="260"/>
		    <TableColumn fx:id="groupNameColumn" text="Group" prefWidth="150"/>
		    <TableColumn fx:id="thumbnailColumn" text="Thumbnail" prefWidth="90"/>
		</columns>
		<columnResizePolicy>
		    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
		</columnResizePolicy>
	    </TableView>
	    <ProgressIndicator fx:id="loadingIndicator" maxWidth="50" maxHeight="50"/>
	</StackPane>
	<Button fx:id="importButton" text="Import" onAction="#importRepo"/>
    </VBox>
</fx:root>

    

